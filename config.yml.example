# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# Strict global public-IP leases (requires upgraded Xboard + Flux):
# kernel:
#   type: "singbox"  # or xray; raw TCP transport only
#   strict_device_leases: true
#   trusted_proxies: ["203.0.113.10/32"] # actual final-hop relay IPs; never 0.0.0.0/0
# Keep native UDP, multiplex and additional custom inbounds disabled.
